{
    "main": ".open-next/worker.js",
    "name": "onc-limb",
    "compatibility_date": "2025-10-01",
    "compatibility_flags": ["nodejs_compat"],
    "minify": true,
    "keep_vars": true,
    "build": {
        "command": "opennextjs-cloudflare build"
    },
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "observability": {
        "logs": {
            "enabled": true,
            "invocation_logs": true
        }
    } 
}
