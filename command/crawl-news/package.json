{
  "name": "crawl-news",
  "version": "1.0.0",
  "description": "RSSフィードからニュースを取得し、Gemini AIで要約してマークダウンとして出力するツール",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "crawl": "tsx src/index.ts",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@libsql/client": "^0.14.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.38.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "minimatch": ">=10.2.3",
      "brace-expansion": ">=5.0.5"
    }
  }
}
